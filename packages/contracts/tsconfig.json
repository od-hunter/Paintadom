{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["./hardhat.config.js", "./scripts/**/*.js", "./test/**/*.js"],
  "exclude": ["node_modules", "artifacts", "cache"]
}
