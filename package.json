{
  "name": "paintadom",
  "version": "0.1.0",
  "description": "Paintadom — gamified digital coloring book MiniPay Mini App",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "type-check": "turbo type-check",
    "contracts:compile": "pnpm --filter @paintadom/contracts compile",
    "contracts:test": "pnpm --filter @paintadom/contracts test",
    "contracts:deploy:sepolia": "pnpm --filter @paintadom/contracts deploy:sepolia",
    "contracts:deploy:mainnet": "pnpm --filter @paintadom/contracts deploy:mainnet",
    "contracts:upgrade:sepolia": "pnpm --filter @paintadom/contracts upgrade:sepolia"
  },
  "devDependencies": {
    "@types/node": "^20.8.0",
    "turbo": "^1.10.16",
    "typescript": "^5.2.2"
  },
  "packageManager": "pnpm@8.10.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
