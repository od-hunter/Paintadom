# Sparks shop treasury — fallback payout when PaintadomGame is not deployed
NEXT_PUBLIC_SPARKS_TREASURY=

# Upgradeable PaintadomGame proxy (UUPS) on Celo
# Deploy: pnpm contracts:deploy:sepolia  (or :mainnet)
NEXT_PUBLIC_PAINTADOM_GAME_ADDRESS=

# Chain for server reads / claim signatures
# 11142220 = Celo Sepolia (default for now) · 42220 = Celo mainnet (later)
NEXT_PUBLIC_CHAIN_ID=11142220
CHAIN_ID=11142220

# Backend reward signer — must match contract.rewardSigner() (never expose to client)
REWARD_SIGNER_PRIVATE_KEY=

# Optional RPC overrides for API routes
CELO_RPC=https://forno.celo.org
CELO_SEPOLIA_RPC=https://forno.celo-sepolia.celo-testnet.org

# Magic.link — social / embedded wallet (Google OAuth + email)
# 1. Create an app at https://dashboard.magic.link
# 2. Copy the Publishable API Key
# 3. Enable Google under Social Login and paste Google Client ID + Secret
# 4. Add your app URL to Magic Allowed Origins + Google redirect URIs
NEXT_PUBLIC_MAGIC_API_KEY=

# Resend — required to deliver real verification emails
# Get a free key at https://resend.com
RESEND_API_KEY=
# Optional verified sender, e.g. Paintadom <noreply@yourdomain.com>
# Default uses Resend's onboarding@resend.dev (only delivers to your Resend account email)
RESEND_FROM_EMAIL=
